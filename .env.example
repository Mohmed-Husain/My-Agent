# ==========================================
# My Agent - Environment Configuration
# ==========================================

# Backend (FastAPI + DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database Connection (Aiven PostgreSQL or fallback SQLite)
DATABASE_URL=postgres://avnadmin:your_aiven_password@your_pg_host.aivencloud.com:13480/defaultdb?sslmode=require
RESET_DB_ON_STARTUP=false

# Admin secret for viewing visitor logs and analytics
ADMIN_SECRET=husain-agent-secret-2026

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
